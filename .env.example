# Snailpost environment. Copy to .env.local for local development.
# Without the Supabase values the app runs fully local (creation, preview,
# voice, keepsakes, print) and says plainly that sending links isn't set up.

# Public (safe in the browser): project URL and anon key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server only. Never prefix with NEXT_PUBLIC_. Used by /api/publish,
# /api/links/revoke and /p/[token] to validate tokens and sign media URLs.
SUPABASE_SERVICE_ROLE_KEY=

# Canonical public origin used to build share links and QR codes,
# e.g. https://snailpost.vercel.app (no trailing slash).
PUBLIC_SITE_URL=
